# Enter these locally. Copy the existing dashboard engine values; never commit secrets.
SUPABASE_DB_URL=postgresql://desk_runtime.PROJECT:PASSWORD@HOST:6543/postgres?sslmode=require
BROKER_SECRET_KEY=REPLACE_WITH_THE_EXISTING_ENGINE_KEY
OPENAI_API_KEY=REPLACE_WITH_YOUR_EXISTING_OPENAI_KEY
AGENT_MODEL=REPLACE_WITH_YOUR_CONFIGURED_MODEL
KILL_SWITCH_ENABLED=true
# Needed only when the selected profile requires these providers.
FINNHUB_ENABLED=false
FINNHUB_API_KEY=
FRED_ENABLED=false
FRED_API_KEY=
