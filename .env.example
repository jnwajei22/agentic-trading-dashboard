# Auth0 Regular Web Application (server-only)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://mcp.justinnwajei.com

# Public HTTPS origin of the existing Agentic Forex Desk FastAPI service.
# Despite the legacy variable name, this value is consumed only by Next.js server code.
BACKEND_API_BASE_URL=
# Deprecated compatibility fallback: NEXT_PUBLIC_API_BASE_URL=

# Optional sanitized server diagnostics. Never logs tokens, cookies, or bodies.
BACKEND_DIAGNOSTICS_ENABLED=false
